# VisionGuard Configuration

# Security & Debug
DEBUG=False
PROJECT_NAME="VisionGuard"
API_V1_PREFIX="/api/v1"

# Database Configuration (PostgreSQL for Docker/Production, SQLite fallback for fast local testing)
# Example PostgreSQL: postgresql+asyncpg://visionguard:visionguard_secret@localhost:5432/visionguard
DATABASE_URL=sqlite+aiosqlite:///./visionguard.db
SYNC_DATABASE_URL=sqlite:///./visionguard.db

# PostgreSQL Credentials (used by Docker Compose)
POSTGRES_USER=visionguard
POSTGRES_PASSWORD=visionguard_secret
POSTGRES_DB=visionguard

# CPU Inference Resource Management
CPU_INFERENCE_THREADS=8
MAX_CONCURRENT_JOBS=1
DEVICE=cpu

# Video Ingestion Constraints
MAX_UPLOAD_SIZE_BYTES=209715200  # 200 MB
